<mxfile host="app.diagrams.net">
  <diagram name="test3" id="test3">
    <mxGraphModel dx="1000" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Блоки -->
        <mxCell id="start" value="Начало" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="20" width="120" height="40" as="geometry" />
        </mxCell>
        <mxCell id="init" value="numbers = [3, 7, 12, 0, 25, 4]&lt;br&gt;total = 0" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="260" y="90" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="loop" value="for n in numbers" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;size=0.15;" vertex="1" parent="1">
          <mxGeometry x="260" y="190" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="match" value="match&lt;br&gt;n % 3" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="290" y="290" width="140" height="80" as="geometry" />
        </mxCell>

        <mxCell id="d0" value="n &amp;gt; 10" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="70" y="410" width="140" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p0" value="total += n" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="70" y="530" width="140" height="50" as="geometry" />
        </mxCell>

        <mxCell id="d1" value="n &amp;lt; 5" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="290" y="410" width="140" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p1" value="total -= 1" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="290" y="530" width="140" height="50" as="geometry" />
        </mxCell>

        <mxCell id="p2" value="total += 2" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="510" y="425" width="140" height="50" as="geometry" />
        </mxCell>

        <mxCell id="j1" value="" style="ellipse;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="355" y="620" width="10" height="10" as="geometry" />
        </mxCell>

        <mxCell id="d3" value="n == 0" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="290" y="660" width="140" height="80" as="geometry" />
        </mxCell>
        <mxCell id="o1" value="Вывод «zero»" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;" vertex="1" parent="1">
          <mxGeometry x="510" y="675" width="140" height="50" as="geometry" />
        </mxCell>

        <mxCell id="j2" value="" style="ellipse;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="355" y="775" width="10" height="10" as="geometry" />
        </mxCell>

        <mxCell id="d4" value="total &amp;gt; 20" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="290" y="850" width="140" height="80" as="geometry" />
        </mxCell>
        <mxCell id="o2" value="Вывод total" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;" vertex="1" parent="1">
          <mxGeometry x="280" y="970" width="160" height="50" as="geometry" />
        </mxCell>
        <mxCell id="j3" value="" style="ellipse;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="355" y="1050" width="10" height="10" as="geometry" />
        </mxCell>
        <mxCell id="end" value="Конец" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="1090" width="120" height="40" as="geometry" />
        </mxCell>

        <!-- Связи -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="start" target="init">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="init" target="loop">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="loop" target="match">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Ветки match -->
        <mxCell id="m0" value="0" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;exitX=0;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="match" target="d0">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m1" value="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="match" target="d1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m2" value="_" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="match" target="p2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="d0y" value="Да" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="d0" target="p0">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="d0n" value="Нет" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="d0" target="j1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="40" y="450" />
              <mxPoint x="40" y="625" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="p0j" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="p0" target="j1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="140" y="625" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="d1y" value="Да" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="d1" target="p1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="d1n" value="Нет" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="d1" target="j1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="470" y="450" />
              <mxPoint x="470" y="625" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="p1j" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p1" target="j1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2j" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="p2" target="j1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="580" y="625" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- if n == 0 -->
        <mxCell id="j1d3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="j1" target="d3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="d3y" value="Да" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="d3" target="o1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="d3n" value="Нет" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="d3" target="j2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="o1j" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="o1" target="j2">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="580" y="780" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Возврат к началу цикла -->
        <mxCell id="back" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="j2" target="loop">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="10" y="780" />
              <mxPoint x="10" y="220" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Выход из цикла -->
        <mxCell id="exit" value="Конец цикла" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="loop" target="d4">
          <mxGeometry x="-0.85" relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="700" y="220" />
              <mxPoint x="700" y="820" />
              <mxPoint x="360" y="820" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- if total > 20 -->
        <mxCell id="d4y" value="Да" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="d4" target="o2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="d4n" value="Нет" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="d4" target="j3">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
